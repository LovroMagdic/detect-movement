.DS_Store
.DS_*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
*.sublime*
.cursor/
.claude/settings.local.json

# ============================================================
