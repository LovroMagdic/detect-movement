# ============================================================
.env
.env.*
!.env.example
*.pem
*.key

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
.eggs/
/build/
/dist/
.venv/
venv/
env/
ENV/
.python-version

# Test / type-check / lint caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.hypothesis/
