celerybeat-schedule
celerybeat.pid
*.rdb

# ============================================================
# Frontend (Node / Vite / TypeScript)
# ============================================================
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
# Emitted by `tsc -b` next to vite.config.ts
frontend/vite.config.js
frontend/vite.config.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================
# Runtime data / pipeline outputs
# ============================================================
# SQLite job artifact database (keep the folder via .gitkeep)
backend/database/*
!backend/database/.gitkeep

# Job data and uploads
backend/data/
backend/uploads-temp/

# Outputs from the standalone detection scripts
final_output/
frames_*/
stitched_map*
dead_heatmap*
movement_data_*.csv

# Media files (input videos / generated images)
*.mp4
*.mov
*.avi
*.mkv
*.jpg
*.jpeg
*.png
*.tif
*.tiff
# ...but keep images that are part of the frontend
!frontend/public/**
!frontend/src/**/*.png
!frontend/src/**/*.jpg
!frontend/src/**/*.jpeg

# ============================================================
# Logs / misc
# ============================================================
*.log
logs/
**/*.backup.*
**/*.back.*
